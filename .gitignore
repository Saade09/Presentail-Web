# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared
**/dist-web-review/

# Generated audit exports
/presentail_audit_summary.md
/presentail_full_site_audit.csv
/presentail_full_site_audit.xlsx

# Generated optimization snapshots (dated baselines stay reviewable)
/docs/reports/optimization-baseline-latest.json

# Agent/merge scratch files
/dot-replit.backup
/conflict_region.txt
/resolved_tests.ts
/patch_promo.js

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Google Play service account key (never commit)
artifacts/presentail/google-service-account.json

# Apple App Store Connect API keys (never commit)
*.p8

# Playwright test artifacts
**/test-results/

# Deployment context: historical uploads stay in the workspace/repository, but
# only the attachment assets imported by the web build and store-release media
# are uploaded when publishing.
/attached_assets/*
!/attached_assets/Elegant-dark-teal-stationery-design_1778742277420.avif
!/attached_assets/Presentail-Arabic-Logo-white.png
!/attached_assets/Presentail-Arabic-Logo-white.webp
!/attached_assets/Presentail-Arabic-Logo.png
!/attached_assets/Presentail-Arabic-Logo.webp
!/attached_assets/Presentail_PNG-01_1777795626872.png
!/attached_assets/Presentail_PNG-01_1777795626872.webp
!/attached_assets/Presentail_PNG-01_white.png
!/attached_assets/Presentail_PNG-01_white.webp
!/attached_assets/play-store/
!/attached_assets/play-store/**

# Generated and temporary deployment output. Publish/build commands recreate
# these from source; committed snapshots must not be uploaded as build inputs.
/artifacts/presentail/static-build/
/artifacts/presentail-web/public/blog/*-480.webp
/artifacts/presentail-web/public/blog/*-768.webp
/tmp-dist/

# Historical visual QA evidence is not a runtime or release input.
/screenshots/
/artifacts/presentail-web/screenshots/
