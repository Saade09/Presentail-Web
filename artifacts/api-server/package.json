{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "release-build": "node ./scripts/release-build.mjs",
    "verify-migration-gate": "node ./scripts/verify-migration-gate.mjs",
    "verify-build": "node ../../scripts/build-artifact-provenance.mjs --name api --artifact-dir dist --verify --max-bytes 8000000 --forbidden-extensions .map && node ./scripts/verify-source-map-artifact.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "pnpm -w run typecheck:libs && tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "pnpm -w run typecheck:libs && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:image-delivery": "node scripts/check-image-delivery.mjs",
    "backfill:product-social": "node ./scripts/backfill-product-social-cards.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.15",
    "@clerk/shared": "^4.10.2",
    "@google-cloud/storage": "^7.19.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/catalog-data": "workspace:*",
    "@workspace/delivery": "workspace:*",
    "@workspace/clerk-types": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/display-currency": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/presentail-os": "workspace:*",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.4.1",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^4.1.1",
    "image-size-next": "^2.1.1",
    "jose": "^6.2.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "resend": "^4.0.0",
    "openai": "^6.27.0",
    "pino": "^9",
    "pino-http": "^10",
    "sharp": "^0.35.1",
    "stripe": "^22.0.2",
    "svix": "^1.93.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@workspace/eslint-config-base": "workspace:*",
    "esbuild": "^0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "eslint": "^9.39.4",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.5"
  }
}
