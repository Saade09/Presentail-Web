{
  "expo": {
    "name": "Presentail",
    "slug": "presentail",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "presentail",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-native-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBF4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "presentail",
      "buildNumber": "33",
      "usesAppleSignIn": true,
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(CFBundleIdentifier)"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan QR codes for gift messages.",
        "NSPhotoLibraryUsageDescription": "Used to select photos for personalised gifts.",
        "NSUserNotificationUsageDescription": "Allow notifications so we can update you about your orders, deliveries, and gift moments.",
        "NSLocationWhenInUseUsageDescription": "Used to show prices in your local currency.",
        "CFBundleDisplayName": "Presentail",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "ar",
          "fr"
        ]
      },
      "associatedDomains": [
        "applinks:presentail.com"
      ]
    },
    "android": {
      "label": "Presentail",
      "package": "com.presentail.lb",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#00414E"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "presentail.com",
              "pathPrefix": "/product/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "presentail.com",
              "pathPrefix": "/lebanon/wp-login.php"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/4dfed5db-2405-4de3-bca5-0e0ce9da84c0",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#00414E"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.presentail",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4dfed5db-2405-4de3-bca5-0e0ce9da84c0"
      }
    }
  }
}
