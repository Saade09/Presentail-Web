{
  "expo": {
    "name": "Presentail Lebanon",
    "slug": "presentail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "presentail",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00414E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "presentail",
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan QR codes for gift messages.",
        "NSPhotoLibraryUsageDescription": "Used to select photos for personalised gifts.",
        "CFBundleDisplayName": "Presentail",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "presentail",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#00414E"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/4dfed5db-2405-4de3-bca5-0e0ce9da84c0"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4dfed5db-2405-4de3-bca5-0e0ce9da84c0"
      }
    }
  }
}
