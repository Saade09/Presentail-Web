{
  "expo": {
    "name": "Presentail - Flowers & Gifts",
    "slug": "presentail",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "presentail",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon-cream.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBF4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "presentail",
      "buildNumber": "9",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan QR codes for gift messages.",
        "NSPhotoLibraryUsageDescription": "Used to select photos for personalised gifts.",
        "NSUserNotificationUsageDescription": "Allow notifications so we can update you about your orders, deliveries, and gift moments.",
        "CFBundleDisplayName": "Presentail - Flowers & Gifts",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:presentail.com"
      ]
    },
    "android": {
      "package": "com.presentail.lb",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#00414E"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "presentail.com",
              "pathPrefix": "/lebanon/wp-login.php"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/4dfed5db-2405-4de3-bca5-0e0ce9da84c0",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#00414E"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4dfed5db-2405-4de3-bca5-0e0ce9da84c0"
      }
    }
  }
}
