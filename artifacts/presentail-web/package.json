{
  "name": "@workspace/presentail-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "node scripts/generate-blog-hero-variants.mjs && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build --config vite.config.ts && node compress-assets.mjs && node check-build-integrity.mjs",
    "check-build-integrity": "node check-build-integrity.mjs",
    "generate-blog-hero-variants": "node scripts/generate-blog-hero-variants.mjs",
    "check-blog-hero-variants": "node scripts/check-blog-hero-variants.mjs",
    "check-product-jsonld-schema": "node scripts/check-product-jsonld-schema.mjs",
    "check-nonproduct-jsonld-schema": "node scripts/check-nonproduct-jsonld-schema.mjs",
    "check-jsonld-rich-results": "node scripts/check-jsonld-rich-results.mjs",
    "start": "test -f dist/public/index.html || { echo 'ERROR: dist/public/index.html is missing — run the Vite build step before starting the server' >&2; exit 1; } && node serve.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "pnpm -w run typecheck:libs && tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "pnpm -w run typecheck:libs && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "check:i18n": "pnpm --filter @workspace/scripts run check-unused-web-translations",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "sh -c 'PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=\"${PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH:-$(command -v chromium 2>/dev/null)}\" playwright test'",
    "test:e2e:serve": "sh -c 'PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=\"${PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH:-$(command -v chromium 2>/dev/null)}\" playwright test --config playwright.serve.config.ts'",
    "check-chunk-budget": "node scripts/check-chunk-budget.mjs dist/public && node scripts/check-logo-preload.mjs dist/public",
    "check-css-budget": "node scripts/check-css-budget.mjs dist/public",
    "check-logo-preload": "node scripts/check-logo-preload.mjs dist/public",
    "check-font-not-inlined": "node scripts/check-font-not-inlined.mjs dist/public",
    "check-font-files-emitted": "node scripts/check-font-files-emitted.mjs dist/public",
    "check-font-face-declarations": "node scripts/check-font-face-declarations.mjs dist/public",
    "check-stripe-isolation": "node scripts/check-stripe-isolation.mjs dist/public",
    "check-clarity-snippet": "node scripts/check-clarity-snippet.mjs dist/public",
    "check-web-vitals-budget": "node scripts/check-web-vitals-budget.mjs dist/public",
    "benchmark:storefront": "node scripts/benchmark-storefront-performance.mjs",
    "check-public-image-budget": "node scripts/check-public-image-budget.mjs public",
    "check-font-budget": "node scripts/check-public-font-budget.mjs src/fonts",
    "check-contact-title-length": "node scripts/check-contact-title-length.mjs",
    "check-seo-title-length": "node scripts/check-seo-title-length.mjs",
    "check-seo-regression": "node scripts/check-seo-regression.mjs",
    "check-static-entity-title-lengths": "node scripts/check-static-entity-title-lengths.mjs",
    "generate-og-image": "node scripts/generate-og-image.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.59.1",
    "@radix-ui/react-accordion": "^1.2.4",
