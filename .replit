modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[[deployment.responseHeaders]]
path = "/app-static/"
name = "Cache-Control"
value = "public, max-age=300, stale-while-revalidate=60"

[[deployment.responseHeaders]]
path = "/app-static/index.html"
name = "Cache-Control"
value = "public, max-age=300, stale-while-revalidate=60"

[[deployment.responseHeaders]]
path = "/app-static/ios/manifest.json"
name = "Cache-Control"
value = "no-store"

[[deployment.responseHeaders]]
path = "/app-static/ios/manifest.json"
name = "Expo-Protocol-Version"
value = "1"

[[deployment.responseHeaders]]
path = "/app-static/ios/manifest.json"
name = "Expo-SFV-Version"
value = "0"

[[deployment.responseHeaders]]
path = "/app-static/ios/manifest.json"
name = "X-Presentail-Asset-Delivery"
value = "static"

[[deployment.responseHeaders]]
path = "/app-static/android/manifest.json"
name = "Cache-Control"
value = "no-store"

[[deployment.responseHeaders]]
path = "/app-static/android/manifest.json"
name = "Expo-Protocol-Version"
value = "1"

[[deployment.responseHeaders]]
path = "/app-static/android/manifest.json"
name = "Expo-SFV-Version"
value = "0"

[[deployment.responseHeaders]]
path = "/app-static/android/manifest.json"
name = "X-Presentail-Asset-Delivery"
value = "static"

[[deployment.responseHeaders]]
path = "/app-static/*"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-hardcoded-web-strings"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "compression-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-hardcoded-mobile-strings"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-api-compression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-social-share-previews"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-social-share-previews-prod"

[[workflows.workflow]]
name = "check-hardcoded-web-strings"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check-hardcoded-web-strings"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "compression-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'set -e; pnpm --filter @workspace/presentail-web run build; PORT=19234 BASE_PATH=\"/\" node artifacts/presentail-web/serve.mjs & SERVER_PID=$!; trap \"kill $SERVER_PID 2>/dev/null\" EXIT INT TERM; sleep 3; node artifacts/presentail-web/scripts/check-compression.mjs http://localhost:19234/ http://localhost:19234/product/gold-heart-balloon--313 http://localhost:19234/brand/roses-de-chloe http://localhost:19234/occasion/birthday http://localhost:19234/category/balloons http://localhost:19234/en-lb/beirut http://localhost:19234/en-lb/beirut/product/gold-heart-balloon--313 http://localhost:19234/en-lb/beirut/category/balloons; node artifacts/presentail-web/scripts/check-sidecar-blocking.mjs http://localhost:19234'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-hardcoded-mobile-strings"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check-hardcoded-mobile-strings"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-api-compression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'set -e; HEADERS=$(curl -sf -D - --compressed -o /dev/null http://localhost:8080/api/woo/products 2>&1); ENCODING=$(echo \"$HEADERS\" | grep -i \"^content-encoding:\" || true); if [ -n \"$ENCODING\" ]; then echo \"PASS  /api/woo/products — $ENCODING\"; else echo \"FAIL  /api/woo/products — no Content-Encoding header; ensure API server is running with compression middleware\"; exit 1; fi'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-social-share-previews"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = """
bash -c 'set -e
pnpm --filter @workspace/presentail-web run build
pnpm --filter @workspace/api-server run build

PORT=8080 node artifacts/api-server/dist/index.mjs &
API_PID=$!
PORT=19235 BASE_PATH=\"/\" INTERNAL_API_BASE_URL=\"http://localhost:8080\" node artifacts/presentail-web/serve.mjs &
WEB_PID=$!
trap \"kill $API_PID $WEB_PID 2>/dev/null\" EXIT INT TERM

echo \"Waiting for API server on :8080...\"
for i in $(seq 1 30); do nc -z localhost 8080 2>/dev/null && break; sleep 1; done
nc -z localhost 8080 2>/dev/null || { echo \"FAIL: API server did not start on :8080 within 30s\"; exit 1; }
echo \"API server ready.\"

echo \"Waiting for web server on :19235...\"
for i in $(seq 1 30); do nc -z localhost 19235 2>/dev/null && break; sleep 1; done
nc -z localhost 19235 2>/dev/null || { echo \"FAIL: web server did not start on :19235 within 30s\"; exit 1; }
echo \"Web server ready.\"

node artifacts/presentail-web/scripts/check-social-share-previews.mjs http://localhost:19235 http://localhost:8080'"""

[[workflows.workflow]]
name = "check-social-share-previews-prod"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/presentail-web/scripts/check-social-share-previews-prod.mjs"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-sheet:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
PAYPAL_CLIENT_ID = "BAAm4Bv7_LMv19VEMB1We2VTaZuWx8dg2fL94_ECHXOijrN-cab-PcZmRiRU0rU3BcH4tXXrZdfirP2mhA"
PRESENTAIL_OS_API_URL = "https://os.presentail.com"
OS_PRODUCTS_DISABLED = "1"
VITE_FB_PIXEL_ID_LB = "516675752539139"
VITE_FB_PIXEL_ID_AE = "604339571940277"
APPLE_CLIENT_IDS = "presentail"
VITE_STRIPE_MERCHANT_COUNTRY = "CY"
VITE_STRIPE_MERCHANT_COUNTRY_GULF = "AE"
VITE_GOOGLE_MERCHANT_CENTER_VERIFICATION = "8KYs1Wv7_PTXWPagrMKPSPHAfev_als-fU4IVc72V_U"
