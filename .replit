modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-hardcoded-web-strings"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "compression-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-hardcoded-mobile-strings"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-api-compression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-serve-blog"

[[workflows.workflow]]
name = "check-hardcoded-web-strings"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check-hardcoded-web-strings"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "compression-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'set -e; pnpm --filter @workspace/presentail-web run build; PORT=19234 BASE_PATH=\"/\" node artifacts/presentail-web/serve.mjs & SERVER_PID=$!; sleep 3; node artifacts/presentail-web/scripts/check-compression.mjs http://localhost:19234/; node artifacts/presentail-web/scripts/check-sidecar-blocking.mjs http://localhost:19234; kill $SERVER_PID 2>/dev/null'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-hardcoded-mobile-strings"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check-hardcoded-mobile-strings"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-api-compression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'set -e; HEADERS=$(curl -sf -D - --compressed -o /dev/null http://localhost:8080/api/woo/products 2>&1); ENCODING=$(echo \"$HEADERS\" | grep -i \"^content-encoding:\" || true); if [ -n \"$ENCODING\" ]; then echo \"PASS  /api/woo/products — $ENCODING\"; else echo \"FAIL  /api/woo/products — no Content-Encoding header; ensure API server is running with compression middleware\"; exit 1; fi'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "e2e-serve-blog"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "SERVE_E2E_SPEC=blog-image-perf.spec.ts bash artifacts/presentail-web/scripts/run-serve-e2e.sh"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-sheet:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

