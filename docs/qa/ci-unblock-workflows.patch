+
+      - name: Build web app
+        if: steps.web-dist-cache.outputs.cache-hit != 'true'
+        # Inert CI-only values so the env-placeholder guard in vite.config.ts can
+        # pass. Empty IDs disable analytics (no Meta pixel or gtag property is
+        # initialised). Production values come from Replit secrets at deploy
+        # time; this build artefact is never deployed.
