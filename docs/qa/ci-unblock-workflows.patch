+        # initialised). Production values come from Replit secrets at deploy
+        # time; this build artefact is never deployed.
+        env:
+          VITE_FB_PIXEL_ID_LB: ""
+          VITE_FB_PIXEL_ID_AE: ""
+          VITE_GTAG_ADS_ID: ""
+          VITE_GTAG_GA4_ID: ""
+          VITE_GTAG_ADS_ID_UAE: ""
         run: |
           started=$(date +%s%3N)
           pnpm --filter @workspace/presentail-web run build
@@ -196,6 +206,13 @@ jobs:
         if: steps.preview.outputs.use_local == 'true'
         env:
           BUILD_CACHE_HIT: ${{ steps.web-dist-cache.outputs.cache-hit }}
+          # The provenance cache key hashes VITE_* vars, so these must match
+          # the inert values given to the build step above.
