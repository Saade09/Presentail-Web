+          VITE_FB_PIXEL_ID_LB: ""
+          VITE_FB_PIXEL_ID_AE: ""
+          VITE_GTAG_ADS_ID: ""
+          VITE_GTAG_GA4_ID: ""
+          VITE_GTAG_ADS_ID_UAE: ""
+        run: pnpm --filter @workspace/presentail-web run build
+
+      - name: Verify web provenance, integrity, and size budget
+        env:
+          BUILD_CACHE_HIT: ${{ steps.web-dist-cache.outputs.cache-hit }}
+          # The provenance cache key hashes VITE_* vars, so these must match
+          # the inert values given to the build step above.
+          VITE_FB_PIXEL_ID_LB: ""
+          VITE_FB_PIXEL_ID_AE: ""
+          VITE_GTAG_ADS_ID: ""
+          VITE_GTAG_GA4_ID: ""
+          VITE_GTAG_ADS_ID_UAE: ""
+        run: pnpm --filter @workspace/presentail-web run verify-build
+
       - name: Run web unit tests
         run: pnpm --filter @workspace/presentail-web run test
